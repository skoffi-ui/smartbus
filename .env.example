# ========================================
# SMARTBUS - Variables d'environnement
# ========================================

# Application
NODE_ENV=development
APP_VERSION=1.0.0

# SUPER APP
SUPER_APP_PORT=3000
SUPER_APP_URL=http://localhost:3000

# API GATEWAY (point d'entrée unique des frontends)
GATEWAY_PORT=3002
# Version minimale de l'application cliente acceptée (en-tête x-app-version)
APP_MIN_VERSION=0.0.0

# APP École
SCHOOL_APP_PORT=3001
SCHOOL_APP_URL=http://localhost:3001

# ----------------------------------------
# Base de données centrale (SUPER APP)
# ----------------------------------------
SUPER_DB_HOST=localhost
SUPER_DB_PORT=5432
SUPER_DB_NAME=smartbus_super
SUPER_DB_USER=postgres
SUPER_DB_PASSWORD=your_password_here

# ----------------------------------------
# Plateforme GPS Libellule.
# ATTENTION : la cle precedente etait en dur dans le code et figure dans
# l'historique Git. La considerer comme eventee et la renouveler.
# ----------------------------------------
LIBELLULE_API_HASH=

# ----------------------------------------
# Secret partage entre services (SUPER APP -> APP ecole).
# Protege les routes appelees par un service et non par un utilisateur.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ----------------------------------------
INTERNAL_API_KEY=

# ----------------------------------------
# Chiffrement des secrets tiers en base (identifiants BioTime, cles d'appareils)
# 32 octets en hexadecimal. Generer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ----------------------------------------
ENCRYPTION_KEY=

# ----------------------------------------
# JWT
# ----------------------------------------
# Secret de signature des jetons. Aucune valeur de repli : les services refusent
# de demarrer sans lui, ou s'il fait moins de 32 caracteres.
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Secret de signature des jetons de rafraichissement, distinct de JWT_SECRET.
# Aucune valeur de repli : la super-app refuse de demarrer sans lui, s'il fait
# moins de 32 caracteres, ou s'il reprend une valeur deja publiee (dont
# "secret" et l'ancien exemple de ce fichier).
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ----------------------------------------
# Stockage fichiers (MinIO / S3)
# ----------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=smartbus

# ----------------------------------------
# Notifications (Firebase FCM)
# ----------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# ----------------------------------------
# Email (SMTP)
# ----------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@smartbus.com
SMTP_PASS=your_smtp_password
SMTP_FROM=SMARTBUS <noreply@smartbus.com>

# ----------------------------------------
# Redis (BullMQ / Caching)
# ----------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------------------------------
# BioTime Central Server (Multi-Tenant Architecture)
# ----------------------------------------
# URL du serveur BioTime central partagé par toutes les écoles
BIOTIME_CENTRAL_URL=http://your-biotime-server:8080
# Token d'API du serveur BioTime central
# Obtenir depuis: Interface BioTime > Personnel > API Tokens
BIOTIME_CENTRAL_TOKEN=your_biotime_api_token_here

# ----------------------------------------
# Interface d'ecoute de la super-app et de l'app ecole.
# Par defaut 127.0.0.1 : seule la gateway (port 3002) est joignable de l'exterieur,
# ce qui empeche de contourner ses controles en appelant 3000 ou 3001 directement.
# A passer a 0.0.0.0 uniquement si ces services tournent dans des conteneurs separes.
# ----------------------------------------
BIND_HOST=127.0.0.1

# ----------------------------------------
# Mot de passe du compte SUPER_ADMIN cree par `npm run seed:superadmin`.
# Aucune valeur par defaut : le script refuse de s'executer sans elle.
# ----------------------------------------
SUPERADMIN_PASSWORD=
